# ============================================================================
# SRE Copilot — example environment. Copy to `.env` (repo root) or
# `backend/.env` for local development. Contains placeholders only.
# ============================================================================

# ---- Backend: application ----
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# Local dev default (SQLite, no DB server needed):
DATABASE_URL=sqlite:///./sre_copilot.db
# Docker / Postgres (used by deploy/docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://sre_copilot:change-me@db:5432/sre_copilot

# Auto-create the SQLite schema on startup for local/demo use.
# Postgres always uses Alembic migrations; leave this out of production.
AUTO_CREATE_SCHEMA=true

# ---- Backend: HTTP / limits ----
CORS_ORIGINS=http://localhost:3000
# Required so the browser sends the session cookie on cross-origin
# (localhost:3000 -> localhost:8000) requests. Never combine with a "*" origin.
ALLOW_CREDENTIALS=true
MAX_REQUEST_BYTES=2000000
# 0 disables the limiter locally. Set >0 in shared environments; production
# defaults to 120/min when this is left at 0.
RATE_LIMIT_PER_MINUTE=0

# ---- Backend: authentication and workspace ----
# Require a valid session on read-only API routes. Off by default so the demo
# and tests run without credentials; enable in shared environments. Production
# (ENVIRONMENT=production) always enforces authentication.
AUTH_REQUIRED=false
AUTH_COOKIE_NAME=sre_session
AUTH_CSRF_COOKIE_NAME=sre_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_IDLE_HOURS=72
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
# Leave unset to derive from ENVIRONMENT (always on in production). Set false
# only for a deliberate local integration that cannot send the CSRF header.
# CSRF_PROTECTION=false
# Public signup creates a personal workspace owned by the new account. Set a
# non-"default" value only for an intentional shared-workspace deployment whose
# signups should join that tenant as members.
DEFAULT_TENANT_ID=default
# Conservative response headers; production also emits HSTS.
SECURITY_HEADERS_ENABLED=true

# ---- Backend: email verification and password recovery ----
# disabled | console | smtp. Console writes message bodies only at DEBUG log
# level and is rejected in production.
EMAIL_DELIVERY=disabled
EMAIL_FROM=SRE Copilot <no-reply@localhost>
# Set true only after SMTP delivery is verified. Existing migrated accounts are
# treated as verified; new accounts must confirm their address.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ---- Backend: billing (disabled; no payments are collected) ----
# Usage metering and the Stripe webhook receiver are implemented, but checkout
# is deliberately disabled in this release. Leave BILLING_ENABLED=false.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# ---- Backend: optional OAuth ----
# Leave both values blank to hide a provider. Register the callback URL:
#   <OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/{google|github}/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- Backend: AI providers ----
# mock (default, no external calls) | openai | openrouter | anthropic | groq
AI_PROVIDER=mock
# For OpenRouter, use a namespaced model id, e.g. openai/gpt-4o-mini.
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1500
# When true, NO investigation content is sent to an external LLM provider.
AI_PRIVACY_MODE=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Groq uses the OpenAI-compatible chat completions API. Keep the key server-side.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter is OpenAI-compatible. Keep the key server-side only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=SRE Copilot
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- Backend: integrations (all disabled by default) ----
KUBERNETES_ENABLED=false
KUBERNETES_DEMO_MODE=true
KUBERNETES_KUBECONFIG=
KUBERNETES_CONTEXT=
KUBERNETES_IN_CLUSTER=false
# Named clusters (JSON array) take precedence over the legacy single-target
# settings above. On Windows use paths such as C:/Users/you/.kube/config.
# Example:
# KUBERNETES_CLUSTERS=[{"name":"kind-local","kubeconfig":"C:/Users/you/.kube/kind-config","context":"kind-tws-cluster","in_cluster":false}]
KUBERNETES_CLUSTERS=

# Read-only GitHub Actions diagnosis. Use a fine-grained token with
# Actions: read, Contents: read, and Metadata: read. Never grant write scopes.
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=15

# Terraform plan review needs no credentials or environment configuration.

PROMETHEUS_ENABLED=false
# When enabled without a URL and demo mode is true, labelled fixtures are used.
PROMETHEUS_DEMO_MODE=true
PROMETHEUS_URL=
PROMETHEUS_REQUEST_TIMEOUT_SECONDS=15

# ---- Backend: redaction ----
REDACTION_ENABLED=true

# ---- Frontend ----
# Must be a build-time variable for Next.js. Used by deploy/docker-compose.yml
# as a build arg.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk is installed but intentionally unused: no @clerk/nextjs imports, provider,
# or UI. Use the self-hosted /sign-up and /login pages. The legacy package and
# environment names must not be reintroduced into the runtime path.

# ---- Docker Compose only ----
POSTGRES_DB=sre_copilot
POSTGRES_USER=sre_copilot
POSTGRES_PASSWORD=change-me
BACKEND_PORT=8000
FRONTEND_PORT=3000
