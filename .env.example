# ============================================================================
# SRE Copilot — example environment. Copy to `.env` (repo root) or
# `backend/.env` for local development. Contains placeholders only.
# ============================================================================

# ---- Backend: application ----
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# Local dev default (SQLite, no DB server needed):
DATABASE_URL=sqlite:///./sre_copilot.db
# Docker / Postgres (used by deploy/docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://sre_copilot:change-me@db:5432/sre_copilot

# Auto-create the SQLite schema on startup for local/demo use.
# Postgres always uses Alembic migrations; leave this out of production.
AUTO_CREATE_SCHEMA=true

# ---- Backend: HTTP / limits ----
CORS_ORIGINS=http://localhost:3000
# Required so the browser sends the session cookie on cross-origin
# (localhost:3000 -> localhost:8000) requests. Never combine with a "*" origin.
ALLOW_CREDENTIALS=true
MAX_REQUEST_BYTES=2000000
# 0 disables the limiter. Set >0 in shared environments.
RATE_LIMIT_PER_MINUTE=0

# ---- Backend: authentication (local, self-hosted) ----
# Require a valid session on the read-only API routes. Off by default so the
# demo and the test suite run without credentials; enable in shared environments.
AUTH_REQUIRED=false
AUTH_COOKIE_NAME=sre_session
AUTH_SESSION_TTL_HOURS=168

# ---- Backend: AI providers ----
# mock (default, no external calls) | openai | openrouter | anthropic
AI_PROVIDER=mock
# For OpenRouter, use a namespaced model id, e.g. openai/gpt-4o-mini.
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1500
# When true, NO investigation content is sent to an external LLM provider.
AI_PRIVACY_MODE=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter is OpenAI-compatible. Keep the key server-side only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=SRE Copilot
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- Backend: integrations (all disabled by default) ----
KUBERNETES_ENABLED=false
KUBERNETES_DEMO_MODE=true
KUBERNETES_KUBECONFIG=
KUBERNETES_CONTEXT=
KUBERNETES_IN_CLUSTER=false

# Read-only GitHub Actions diagnosis. Use a fine-grained token with
# Actions: read, Contents: read, and Metadata: read. Never grant write scopes.
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=15

# Terraform plan review needs no credentials or environment configuration.

PROMETHEUS_ENABLED=false
PROMETHEUS_URL=

# ---- Backend: redaction ----
REDACTION_ENABLED=true

# ---- Frontend ----
# Must be a build-time variable for Next.js. Used by deploy/docker-compose.yml
# as a build arg.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Frontend: optional authentication (Clerk) ----
# Signup/login are self-hosted by default (accounts + sessions live in the
# backend). Leave these empty to use the local /sign-up and /login pages.
# When both are set at build time, the navigation uses Clerk's modals instead.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Docker Compose only ----
POSTGRES_DB=sre_copilot
POSTGRES_USER=sre_copilot
POSTGRES_PASSWORD=change-me
BACKEND_PORT=8000
FRONTEND_PORT=3000
