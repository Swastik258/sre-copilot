# ---- Backend ----
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO

# Local dev default (SQLite, no DB server needed):
DATABASE_URL=sqlite:///./sre_copilot.db
# Docker / Postgres (used by docker-compose):
# DATABASE_URL=postgresql+psycopg://sre_copilot:change-me@db:5432/sre_copilot

CORS_ORIGINS=http://localhost:3000

AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- Docker Compose only ----
POSTGRES_DB=sre_copilot
POSTGRES_USER=sre_copilot
POSTGRES_PASSWORD=change-me
BACKEND_PORT=8000
FRONTEND_PORT=3000