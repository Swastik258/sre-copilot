# ============================================================================
# SRE Copilot production environment example for Docker Compose.
#
# Copy to production.env, replace every CHANGE_ME value, and chmod 600.
# Never commit the completed file. Prefer a secret manager and Kubernetes
# Secrets in multi-host deployments. This stack assumes PostgreSQL is external.
# ============================================================================

# ---- Images (pin by digest for repeatable, approved deploys) ----
BACKEND_IMAGE=ghcr.io/swastik258/sre-copilot-backend@sha256:CHANGE_ME
FRONTEND_IMAGE=ghcr.io/swastik258/sre-copilot-frontend@sha256:CHANGE_ME
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Public origins and database ----
CORS_ORIGINS=https://app.example.com
APP_BASE_URL=https://app.example.com
DATABASE_URL=postgresql+psycopg://sre_copilot:CHANGE_ME_DB_PASSWORD@db.example.internal:5432/sre_copilot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# Set to the IPs of the TLS reverse proxy or load balancer in front of the API.
TRUSTED_PROXY_IPS=10.0.0.10
DEFAULT_TENANT_ID=default
MAX_REQUEST_BYTES=2000000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
IDEMPOTENCY_TTL_HOURS=24

# ---- Observability ----
# Use a long random token for the Prometheus scrape, or set
# METRICS_ALLOW_UNAUTHENTICATED=true only on a network-isolated scrape path.
METRICS_BEARER_TOKEN=CHANGE_ME_LONG_RANDOM_METRICS_TOKEN
METRICS_ALLOW_UNAUTHENTICATED=false
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sre-copilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=0.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Email, recovery, and durable jobs ----
# To enable SMTP, set EMAIL_DELIVERY=smtp and BACKGROUND_JOBS_ENABLED=true,
# then provide a Fernet key (generate with the command in .env.example).
# Production startup refuses SMTP without durable jobs.
EMAIL_DELIVERY=disabled
EMAIL_FROM=SRE Copilot <no-reply@example.com>
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
BACKGROUND_JOBS_ENABLED=false
BACKGROUND_JOB_POLL_SECONDS=5
BACKGROUND_JOB_MAX_ATTEMPTS=5
CREDENTIAL_ENCRYPTION_KEY=

# ---- Optional OAuth ----
OAUTH_REDIRECT_BASE_URL=https://api.example.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- AI (mock is the safe default; no customer data leaves the process) ----
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1500
AI_PRIVACY_MODE=false
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ---- Read-only integrations (disabled until credentials are provisioned) ----
GITHUB_ENABLED=false
GITHUB_TOKEN=
KUBERNETES_ENABLED=false
KUBERNETES_DEMO_MODE=true
KUBERNETES_IN_CLUSTER=false
KUBERNETES_CLUSTERS=
PROMETHEUS_ENABLED=false
PROMETHEUS_DEMO_MODE=true
PROMETHEUS_URL=
REDACTION_ENABLED=true
